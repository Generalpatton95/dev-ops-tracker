DATABASE_URL=
# Direct (non-pooled) Postgres URL for migrations; leave empty to use DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Throwaway Postgres for the database tests; its name must end in _test, as the tests wipe it.
TEST_DATABASE_URL=
# Sign-in (Auth.js). Leave all three empty for no sign-in (as on previews). On hosts other than
# Vercel, also set AUTH_URL to the site's address. Use AUTH_TRUST_HOST=true instead only behind a
# proxy that sets the X-Forwarded-Host and X-Forwarded-Proto headers itself.
# A long random string; also keys the rate-limit hashes, so changing it resets the limits.
AUTH_SECRET=
# The GitHub OAuth App's client id and secret (a separate app for local development).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Name of the header your proxy sets to the caller's IP (x-real-ip on Vercel). Leave empty when
# no trusted proxy sets one: every caller then shares one rate-limit bucket.
TRUSTED_IP_HEADER=
